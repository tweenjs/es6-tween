{
  "name": "es6tween-plugin-morph",
  "version": "0.0.21",
  "description": "SVG Shape Morphing Plugin for es6-tween",
  "main": "morph.js",
  "module": "morph.esmodule.js",
  "cdn": "morph.min.js",
  "scripts": {
    "prepublishOnly": "rollup -c && standard morph.esmodule.js --fix && uglifyjs morph.js -c -m -o morph.min.js",
    "dev": "rollup -c -w"
  },
  "keywords": [
    "morph",
    "animation",
    "es6-tween",
    "performant",
    "sampling",
    "shape",
    "easy",
    "interpolation",
    "svg"
  ],
  "author": "dalisoft",
  "license": "MIT",
  "devDependencies": {
    "rollup": "^4.59.0",
    "rollup-plugin-buble": "^0.19.8",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "snazzy": "^9.0.0",
    "standard": "^17.1.2",
    "svg-points": "^6.0.1",
    "uglify-js": "^3.19.3"
  },
  "standard": {
    "ignore": [
      "morph.js",
      "morph.min.js"
    ]
  },
  "dependencies": {
    "es6-tween": "^5.2.2",
    "flubber": "^0.4.2",
    "points.js": "^1.1.6"
  }
}
