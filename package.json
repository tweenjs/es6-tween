{
  "name": "@es6-tween/workspace",
  "description": "ES6 implementation of amazing tween.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.5",
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
