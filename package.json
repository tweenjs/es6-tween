  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tweenjs/es6-tween/issues"
  },
  "homepage": "https://github.com/tweenjs/es6-tween#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-lerna-scopes": "^21.2.0",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.17",
    "rumdl": "^0.2.78",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "lefthook"
  ]
